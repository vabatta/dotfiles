#!/usr/bin/env bash
# Installs scriptorium's prebuilt commands (theme, cz, dotenv, jwt) from the committed dist/.
# Needs bash 4+ first on PATH: the commands use `#!/usr/bin/env bash`.
set -euo pipefail

rev=db7be54d3f1b10f77e96f20694f4bcf9799de19e
src="${XDG_DATA_HOME:-$HOME/.local/share}/scriptorium"
bin="$HOME/.local/bin"

[[ -d $src/.git ]] || git clone --quiet https://github.com/proventuslabs/scriptorium "$src"
git -C "$src" fetch --quiet origin "$rev"
git -C "$src" checkout --quiet "$rev"

mkdir -p "$bin"
for cmd in "$src"/dist/*/bin/*; do
	ln -sfn "$cmd" "$bin/$(basename "$cmd")"
done
